<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo en la nube y traspaso entre teléfonos (Android 12+). -->
<data-extraction-rules>
    <!-- La sesión (token) no se respalda ni se traspasa: en otro teléfono se pide login de nuevo -->
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
